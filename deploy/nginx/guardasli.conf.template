# GuardAsli — Nginx optimized reverse-proxy template
# Product: GuardAsli · Developer: AsliCode
# Placeholders: __DOMAIN__  __PORT_UI__

# --- upstream (keep-alive to local preview) ---
upstream guardasli_ui {
    server 127.0.0.1:__PORT_UI__;
    keepalive 32;
}

# --- rate limit zones (http context — also in conf.d snippet) ---
# limit_req_zone $binary_remote_addr zone=ga_general:10m rate=30r/s;
# limit_req_zone $binary_remote_addr zone=ga_auth:10m rate=5r/s;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Security headers (certbot may add SSL server block later)
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header X-XSS-Protection "0" always;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types
        text/plain text/css text/javascript
        application/javascript application/json application/xml
        image/svg+xml;

    # Buffers & timeouts (SPA + API feel)
    client_max_body_size 6m;
    client_body_timeout 30s;
    client_header_timeout 15s;
    send_timeout 60s;
    keepalive_timeout 65s;

    # Access / error logs
    access_log /var/log/nginx/guardasli.access.log combined buffer=32k flush=5s;
    error_log  /var/log/nginx/guardasli.error.log warn;

    # ACME challenge (certbot)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type "text/plain";
        allow all;
    }

    # Static assets long cache (hashed vite build)
    location ~* \.(?:js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|ico)$ {
        proxy_pass http://guardasli_ui;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        access_log off;
    }

    # Health for load balancers
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location / {
        # limit_req zone=ga_general burst=60 nodelay;

        proxy_pass http://guardasli_ui;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;
        proxy_busy_buffers_size 32k;
    }
}

# map for websocket Connection header — put in http{} via conf.d/guardasli-map.conf
