{
  "name": "guardasli",
  "version": "0.0.2",
  "description": "GuardAsli control-plane platform by AsliCode — release is0.0.2",
  "author": "AsliCode",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'vite --host 0.0.0.0 --port ${PORT:-5173}'",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "test": "NODE_ENV=test GUARDASLI_ENV=test BUN_TEST=1 bun test",
    "lint": "tsc -b --noEmit",
    "release-check": "bun scripts/release-check.mjs",
    "ci": "bun run typecheck && bun run test && bun run build",
    "prod-start": "bash scripts/prod-start.sh",
    "prod-env": "bun scripts/prod-env-check.mjs",
    "wizard": "bash scripts/wizard.sh",
    "install:wizard": "bash scripts/wizard.sh",
    "up": "bash scripts/up.sh",
    "bootstrap": "bun scripts/auto-bootstrap.mjs",
    "sync-env": "bun scripts/sync-convex-env.mjs",
    "monitor": "bash scripts/monitor-convex.sh",
    "monitor:follow": "bash scripts/monitor-convex.sh --follow",
    "monitor:jobs": "bash scripts/monitor-convex.sh --jobs",
    "nginx:apply": "bash scripts/apply-nginx.sh"
  },
  "dependencies": {
    "convex": "^1.19.0",
    "framer-motion": "^13.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
