# GuardAsli is0.0.1 — کپی به .env.local
# هرگز secret واقعی را commit نکنید

VITE_CONVEX_URL=
CONVEX_DEPLOYMENT=

# AES-256-GCM master (حداقل ۱۶ کاراکتر؛ توصیه: openssl rand -hex 32)
GUARDASLI_MASTER_SECRET=

# Pepper جدا برای هش نشست/API key (توصیه قوی در production)
GUARDASLI_TOKEN_PEPPER=

# آدرس عمومی webhook پرداخت و تلگرام
GUARDASLI_PUBLIC_URL=https://your-domain.com

GUARDASLI_PRODUCT=GuardAsli
GUARDASLI_DEVELOPER=AsliCode
GUARDASLI_VERSION=is0.0.1
