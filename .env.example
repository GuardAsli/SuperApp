# GuardAsli is0.0.1 — کپی به .env.local یا از wizard بسازید:
#   bun run wizard

VITE_CONVEX_URL=
CONVEX_DEPLOYMENT=

# development | production  (در production، TOKEN_PEPPER اجباری است)
GUARDASLI_ENV=development

# AES vault (openssl rand -hex 32)
GUARDASLI_MASTER_SECRET=

# Session pepper — در production الزامی ≥16
GUARDASLI_TOKEN_PEPPER=

# اختیاری: salt جدا برای HKDF و kid برای rotation
GUARDASLI_AEAD_SALT=
GUARDASLI_AEAD_KID=k1

GUARDASLI_PUBLIC_URL=https://your-domain.com
GUARDASLI_CORS_ORIGINS=https://your-domain.com

GUARDASLI_PRODUCT=GuardAsli
GUARDASLI_DEVELOPER=AsliCode
GUARDASLI_VERSION=is0.0.1
