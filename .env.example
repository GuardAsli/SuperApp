# GuardAsli is0.0.1 — کپی به .env.local / Convex dashboard env
# هرگز secret واقعی را commit نکنید

VITE_CONVEX_URL=
CONVEX_DEPLOYMENT=

# AES-256-GCM master (حداقل ۱۶؛ توصیه: openssl rand -hex 32)
GUARDASLI_MASTER_SECRET=

# Pepper نشست (توصیه قوی در production)
GUARDASLI_TOKEN_PEPPER=

# آدرس عمومی webhook
GUARDASLI_PUBLIC_URL=https://your-domain.com

# CORS allowlist — کاما‌جدا؛ هرگز * در production
GUARDASLI_CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

GUARDASLI_PRODUCT=GuardAsli
GUARDASLI_DEVELOPER=AsliCode
GUARDASLI_VERSION=is0.0.1
