# GuardAsli is0.0.1 — کپی به .env.local و مقادیر را پر کنید
# هرگز این فایل را با secret واقعی commit نکنید

# Convex (از داشبورد Convex)
VITE_CONVEX_URL=
CONVEX_DEPLOYMENT=

# رمز اصلی AES-256-GCM برای توکن‌ها و API keyها (حداقل ۳۲ بایت تصادفی)
GUARDASLI_MASTER_SECRET=

# آدرس عمومی برای webhook پرداخت و تلگرام
GUARDASLI_PUBLIC_URL=https://your-domain.com

# هویت (ثابت — تغییر ندهید)
GUARDASLI_PRODUCT=GuardAsli
GUARDASLI_DEVELOPER=AsliCode
GUARDASLI_VERSION=is0.0.1
